{
  "name": "haxlite",
  "version": "0.0.1",
  "description": "Clean-room, ultra-lightweight TypeScript reimplementation of a HaxBall headless host (protocol v9) with an HBInit-compatible API.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:build": "tsc -p tsconfig.build.json --outDir node_modules/.cache/haxlite-bench/dist --declaration false --sourceMap false",
    "bench:sim": "node --experimental-transform-types --no-warnings --import ./bench/ts-resolve.mjs bench/sim.bench.ts",
    "bench:host": "npm run bench:build && node --experimental-transform-types --no-warnings --import ./bench/ts-resolve.mjs bench/net/run.ts",
    "bench:startup": "npm run bench:host -- startup",
    "bench:idle": "npm run bench:host -- idle",
    "bench:game": "npm run bench:host -- game",
    "bench:rooms": "npm run bench:host -- rooms",
    "edge": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/edge.ts"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "node-datachannel": "^0.33.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "haxball.js": "5.1.0",
    "node-haxball": "2.3.1",
    "pako": "^2.2.0",
    "rolldown": "1.2.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "haxlite-edge": "./bin/haxlite-edge.js"
  }
}
