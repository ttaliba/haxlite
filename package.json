{
  "name": "haxlite",
  "version": "0.3.1",
  "description": "Ultra-lightweight TypeScript HaxBall headless host (protocol v9) with an HBInit-compatible API.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:build": "node bench/build.mjs",
    "bench:sim": "node --no-warnings --import ./bench/ts-resolve.mjs bench/sim.bench.ts",
    "bench:host": "node bench/build.mjs && node --no-warnings --import ./bench/ts-resolve.mjs bench/net/run.ts",
    "bench:startup": "npm run bench:host -- startup",
    "bench:idle": "npm run bench:host -- idle",
    "bench:game": "npm run bench:host -- game",
    "bench:rooms": "npm run bench:host -- rooms",
    "bench:soak": "npm run bench:host -- soak",
    "bench:fleet": "npm run bench:host -- fleet",
    "bench:join-impaired": "npm run bench:host -- join-impaired",
    "edge": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/edge.ts",
    "test:interop": "vitest run -c test/rtc-interop/vitest.config.ts"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "haxball.js": "5.1.0",
    "node-haxball": "2.3.1",
    "pako": "^2.2.0",
    "playwright-core": "1.56.1",
    "rolldown": "1.2.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "haxlite-edge": "./bin/haxlite-edge.js"
  }
}
